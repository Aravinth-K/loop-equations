   RowBox[{"list0", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "L6Eq", "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"list2", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{"list0", ",", "list1"}], "]"}]}], ";", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", "\t\t", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             SubscriptBox["a", "i"], 
             RowBox[{"CoMat6", "[", 
              RowBox[{"[", 
