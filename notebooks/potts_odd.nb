    RowBox[{"RowReduce", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Transpose", "[", "CoMat6", "]"}], "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"list0", "=", 
    RowBox[{"{", "}"}]}], ";", " ", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"list0", ",", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"tempMat", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
