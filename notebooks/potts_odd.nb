          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", 
         "1"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
