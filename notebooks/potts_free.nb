Cell[CellGroupData[{

Cell["Level 6 Constraints", "Section",ExpressionUUID->"034eaacf-75fc-4be7-9b23-e2c00c23c6cc"],

Cell[TextData[StyleBox["Perform the following :\n  1. Tabulates the relevant \
equations at this level.\n  2. Compute the matrix of coefficients for the \
level 6 resolvent functions.\n  3. Row - reduce the transpose of the \
coefficient matrix. \n  4. Reading off the column numbers of the first ' 1' \
entry in each row indicates the linearly independent set of equations.\n  5. \
Find the set of coefficients such that you can write the linearly independent \
equations in terms of the found basis.\n  6. Eliminate level 6 resolvent \
functions leaving only constraints on lower order functions.", "Text",
 FontWeight->"Plain"]], "Input",
 CellChangeTimes->{{3.997832184596251*^9, 
  3.997832198227532*^9}},ExpressionUUID->"908a258a-4542-495d-a30f-\
81670e99489c"],

