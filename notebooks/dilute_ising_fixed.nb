Cell["Spectral Curve", "Section",ExpressionUUID->"c828e323-90e4-4720-b19f-66cda3fadc0e"],

Cell[TextData[{
 "The spectral curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", "z", ",", "\[Omega]", ")", "=", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"81674c7b-b28c-4865-acc9-a09314c4252f"],
