     RowBox[{
      SubscriptBox["\[Omega]", 
       RowBox[{"{", "1", ",", "1", "}"}]], ",", 
      SubscriptBox["\[Omega]", 
       RowBox[{"{", "1", ",", "2", "}"}]], ",", 
      SubscriptBox["\[Omega]", 
       RowBox[{"{", "2", ",", "2", "}"}]]}], "}"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"L2Linear", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"L2Eq", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CoefficientArrays", "[", 
          RowBox[{
           RowBox[{"{", "#", "}"}], ",", "L2Variables"}], "]"}], "]"}], " ", "<=",
         " ", "2"}], " ", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"CoMat2", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"CoefficientArrays", "[", 
       RowBox[{"L2Linear", ",", "L2Variables"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"tempMat", " ", "=", " ", 
    RowBox[{"RowReduce", "[", 
     RowBox[{"Transpose", "[", "CoMat2", "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"list1", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"tempMat", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}], ")"}]}], ",", "1",
          ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
