Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "List", " ", "of", " ", "correlator", " ", "labels", " ", "with", " ", 
    "Z_", "2", " ", "symmetry", " ", 
    RowBox[{"factored", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"covarlist", "[", "n_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "g"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["i", "j"], ",", "0", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              SubscriptBox["i", "j"], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Sequence", "@@", "x"}], "//", "Evaluate"}]}], "]"}], ",", 
          RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"A_", ",", "i_"}], "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "B", "}"}], ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"B", "=", 
            RowBox[{"Part", "[", 
             RowBox[{"y", ",", 
              RowBox[{";;", "i"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{
            SubscriptBox["t", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}]], "=", "A"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "2"}], ",", 
             RowBox[{"j", "\[LessEqual]", "n"}], ",", 
             RowBox[{"j", "++"}], ",", 
             RowBox[{
              SubscriptBox["t", 
               RowBox[{"{", 
                RowBox[{"1", ",", "j"}], "}"}]], "=", 
              RowBox[{"RotateRight", "[", 
               SubscriptBox["t", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"(", 
                   RowBox[{"j", "-", "1"}], ")"}]}], "}"}]], "]"}]}]}], "]"}],
            ";", "\[IndentingNewLine]", 
           RowBox[{
            SubscriptBox["t", 
             RowBox[{"{", 
              RowBox[{"2", ",", "1"}], "}"}]], "=", 
            RowBox[{"Reverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "2"}], ",", 
             RowBox[{"j", "\[LessEqual]", "n"}], ",", 
             RowBox[{"j", "++"}], ",", 
             RowBox[{
              SubscriptBox["t", 
               RowBox[{"{", 
                RowBox[{"2", ",", "j"}], "}"}]], "=", 
              RowBox[{"RotateRight", "[", 
               SubscriptBox["t", 
                RowBox[{"{", 
                 RowBox[{"2", ",", 
                  RowBox[{"(", 
                   RowBox[{"j", "-", "1"}], ")"}]}], "}"}]], "]"}]}]}], "]"}],
            ";", "\[IndentingNewLine]", 
           RowBox[{
