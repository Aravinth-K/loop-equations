Cell[CellGroupData[{
Cell["Loop Equations for Fixed-Boundary Dilute Ising", "Title",ExpressionUUID->"67f74ea4-30d7-46d7-9dee-af4d8750f41f"],

Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"877ded3d-d3bb-408a-a390-fd3e7e33bdc9"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox["Y", "2"], "2"], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "0"], "3"], " ", 
        SuperscriptBox["Y", "3"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "2"], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "2"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "3"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "3"]}], ")"}]}], "-", 
       RowBox[{"Y", " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["X", "0"], "+", 
          SubscriptBox["X", "1"]}], ")"}]}]}], "]"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"dba30729-6e6d-4527-a048-f5497c147e27"],
 ".\n\nThe resolvent is taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2f4d0252-80ab-4699-8f13-a4b3c1212799"],
 ", so the cyclic derivative of the action is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", "3"], " ", 
     SuperscriptBox[
      SubscriptBox["X", "0"], "2"]}], "+", 
    RowBox[{
     SubscriptBox["t", "2"], " ", 
     SubscriptBox["X", "0"]}], "-", "Y"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"4bb90048-8460-4254-9475-128e60b5b149"],
 ". \nThe matrix labels used below are 0 for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "5459ff78-33a9-41e5-871c-539836382edf"],
 ", 1 for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "829ddbdb-578f-4a72-b1fe-916447145f39"],
 " and 2 for Y. \nCorrelators have cyclic and reversal symmetry, together \
with the exchange of the occupied matrices. \nResolvent labels retain \
reversal symmetry, since the insertion distinguishes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bc1f9aeb-ac02-4d11-b776-736443636e73"],
 "."
}], "Text",
 CellChangeTimes->{{3.997852038236052*^9, 
  3.997852046844995*^9}},ExpressionUUID->"fb0eee15-0348-448b-a06b-\
1295b2e92657"]
}, Closed]],

