Cell[BoxData[RowBox[{"(* Sort the remaining resolvent word using reversal symmetry. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"sort", "[", "A_", "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"x", ",", "t1", ",", "t2"}], "}"}], ",", RowBox[{RowBox[{"x", "=", RowBox[{"Length", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"t1", "=", "A"}], ";", "\[IndentingNewLine]", RowBox[{"t2", "=", RowBox[{"Reverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Which", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{SubscriptBox["var", "x"], ",", "t1"}], "]"}], ",", "t1", ",", RowBox[{"MemberQ", "[", RowBox[{SubscriptBox["var", "x"], ",", "t2"}], "]"}], ",", "t2"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"sortL", "[", "A_", "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "A", "]"}], "\[NotEqual]", "0"}], ",", RowBox[{"{", RowBox[{RowBox[{RowBox[{"sep", "[", "A", "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", RowBox[{"sort", "[", RowBox[{RowBox[{"sep", "[", "A", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"{", "}"}], ",", RowBox[{"{", "}"}]}], "}"}]}], "]"}]}], ";"}]}]], "Input",
