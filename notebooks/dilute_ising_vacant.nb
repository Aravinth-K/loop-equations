Cell[CellGroupData[{
Cell["Loop Equations for Vacant-Boundary Dilute Ising", "Title",ExpressionUUID->"4148cd3f-b4e2-42b5-b631-18c30f819a94"],

Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"8e5e246e-5ddb-44d2-b982-25612c6a4f46"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox["Y", "2"], "2"], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "0"], "3"], " ", 
        SuperscriptBox["Y", "3"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "2"], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "2"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "3"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "3"]}], ")"}]}], "-", 
       RowBox[{"Y", " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["X", "0"], "+", 
          SubscriptBox["X", "1"]}], ")"}]}]}], "]"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"cc5bff08-24cb-407a-8c36-e656ba849fd3"],
 ".\n\nThe resolvent is taken over the vacancy matrix ",
 "Y",
 ", so the cyclic derivative of the action is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Y", "+", 
    RowBox[{
     SubscriptBox["t", "0"], " ", 
     SuperscriptBox["Y", "2"]}], "-", 
    SubscriptBox["X", "0"], "-", 
    SubscriptBox["X", "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"f44881b9-3ee5-4af2-bf6b-e37d82736fae"],
 ". \nThe matrix labels used below are 0 for Y, 1 for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "bc797a04-4d4c-42fb-bfb1-a04e33a4b18e"],
 " and 2 for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "1"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "32c8f90a-917f-4553-afa5-aafdd7508311"],
 ". \nThe two occupied matrices are interchangeable. \nBoth resolvent and \
correlator labels therefore have the corresponding ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "ac599565-2c22-4b36-94e4-2dc202fe9bf6"],
 " symmetry; correlators also have cyclic symmetry and reversal."
}], "Text",
 CellChangeTimes->{
  3.997849786400683*^9, {3.997858104210045*^9, 
   3.997858107991323*^9}},ExpressionUUID->"16d09ffd-733c-4f89-8dd4-\
a577d497033e"]
}, Closed]],

