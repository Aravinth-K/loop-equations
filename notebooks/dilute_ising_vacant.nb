            RowBox[{
             SubscriptBox["t", 
              RowBox[{"{", 
               RowBox[{"2", ",", "1"}], "}"}]], "=", 
             RowBox[{"Reverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"j", "=", "2"}], ",", 
              RowBox[{"j", "\[LessEqual]", "n"}], ",", 
              RowBox[{"j", "++"}], ",", 
