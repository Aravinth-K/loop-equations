       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["X", "1"], "2"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "2"], "2"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "3"], "2"]}], ")"}], "-", 
       SubscriptBox["X", "0"], " ", 
       SubscriptBox["X", "1"], "-", 
       SubscriptBox["X", "0"], " ", 
       SubscriptBox["X", "2"], "-", 
       SubscriptBox["X", "0"], " ", 
       SubscriptBox["X", "3"], "+", 
       FractionBox[
        SubscriptBox["t", "0"], "3"], " ", 
