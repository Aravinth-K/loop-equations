Notebook[{

Cell[CellGroupData[{
Cell["Loop Equations for Free-Boundary Dilute Ising", "Title",ExpressionUUID->"83cab750-f311-42d0-97ca-01c4650657cd"],

Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"adc92535-8529-40d5-971f-bd7ef2199663"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox["Y", "2"], "2"], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "0"], "3"], " ", 
        SuperscriptBox["Y", "3"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "2"], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "2"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["X", "0"], "3"], "+", 
          SuperscriptBox[
           SubscriptBox["X", "1"], "3"]}], ")"}]}], "-", 
       RowBox[{"Y", " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["X", "0"], "+", 
          SubscriptBox["X", "1"]}], ")"}]}]}], "]"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"ae135356-387a-420f-887b-305e0678b5ec"],
 ".\n\nFor the free boundary set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "=", 
    SubscriptBox["X", "0"], "+", 
    SubscriptBox["X", "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"8cac323d-1846-44bb-a0b0-ddbe81f2c94d"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "1"], "=", 
    SubscriptBox["X", "0"], "-", 
    SubscriptBox["X", "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b21bb2e8-ad72-4380-a12d-06dbc5611810"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "2"], "=", "Y"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"40bf4947-e3cb-40c0-9e2f-da649f55cfe2"],
 ". \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "[", 
      RowBox[{
       FractionBox[
        SuperscriptBox[
         SubscriptBox["M", "2"], "2"], "2"], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "0"], "3"], " ", 
        SuperscriptBox[
         SubscriptBox["M", "2"], "3"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "2"], "4"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["M", "0"], "2"], "+", 
          SuperscriptBox[
           SubscriptBox["M", "1"], "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "12"], " ", 
        SuperscriptBox[
         SubscriptBox["M", "0"], "3"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "4"], " ", 
        SubscriptBox["M", "0"], " ", 
        SuperscriptBox[
         SubscriptBox["M", "1"], "2"]}], "-", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "2"]}]}], "]"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"99a9f4a4-eb13-4a63-9c56-c30d7a577dd4"],
 ". \nThe resolvent is taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "3861d1f8-66d8-4f75-8a5e-c67342238968"],
 ". \nIts cyclic action derivative is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["M", "0"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["M", "1"], "2"]}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "2"], "2"], " ", 
     SubscriptBox["M", "0"]}], "-", 
    SubscriptBox["M", "2"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b914337d-93f3-4d17-ac0f-0b5d2c4a10d1"],
 ". \nThe symmetry ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "1"], "\[Rule]", "-", 
    SubscriptBox["M", "1"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"61aa82a2-f5ec-4f23-bd8f-2390b31a2894"],
 " makes every correlator and auxiliary resolvent with an odd number of 1 \
labels vanish. \nRemaining labels are identified under reversal, with cyclic \
symmetry also applied to correlators."
}], "Text",
 CellChangeTimes->{{3.99785818578199*^9, 
  3.9978582142640657`*^9}},ExpressionUUID->"6e89c2f0-660b-4b2e-96ba-\
5f0f1f7f1e77"]
}, Closed]],

