Cell[CellGroupData[{

Cell["Level 2 & 1 Constraints", "Subsection",ExpressionUUID->"a727914f-d762-49cd-a158-b05ec198f952"],

Cell["\<\
The signed sector removes the level 1 resolvent. Solve the remaining linear \
relation for the level 2 resolvent, then take the common polynomial factor of \
every residual equation.\
\>", "Text",ExpressionUUID->"e32a948e-00fe-42a7-bd0c-33f26e5afd7c"],

Cell[BoxData[
 RowBox[{"Timing", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"L2Eq", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"Eq", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"resolventLevel", "[", "#", "]"}], " ", "<=", " ", "2"}],
             " ", "&"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           SubscriptBox["Con3", "j"], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "nCon3"}], "}"}]}], "]"}]}], "]"}], 
       "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Linear", " ", "=", " ", 
    RowBox[{"First", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"L2Eq", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", 
           SubscriptBox["\[Omega]", 
            RowBox[{"{", "1", ",", "1", "}"}]]}], "]"}], " ", "\[Equal]", " ",
          "1"}], " ", "&"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Sol", " ", "=", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"L2Linear", " ", "\[Equal]", " ", "0"}], ",", 
      SubscriptBox["\[Omega]", 
       RowBox[{"{", "1", ",", "1", "}"}]]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "L2Sol", "]"}], " ", "=!=", " ", "1"}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"EliminationConstraints", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"primitive", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"L2Eq", " ", "/.", " ", 
          RowBox[{"L2Sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L0", " ", "=", " ", 
    RowBox[{"PolynomialGCD", " ", "@@", " ", "EliminationConstraints"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"CurveConstraints", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"First", " ", "/@", " ", 
       RowBox[{"Rest", "[", 
        RowBox[{"FactorList", "[", "L0", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "\[Omega]"}], "]"}], " ", ">=", " ", "2"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "z"}], "]"}], " ", ">=", " ", "1"}]}], " ", 
       "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "CurveConstraints", "]"}], " ", "=!=", " ", 
      "1"}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"FinCurve", " ", "=", " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"First", "[", "CurveConstraints", "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"ReductionChecks", " ", "=", " ", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PolynomialRemainder", "[", 
            RowBox[{"#", ",", "FinCurve", ",", "\[Omega]"}], "]"}], " ", "===",
            " ", "0"}], " ", "&"}], " ", "/@", " ", 
         "EliminationConstraints"}], ")"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PolynomialGCD", "[", 
        RowBox[{"FinCurve", ",", 
         RowBox[{"Denominator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            SubscriptBox["\[Omega]", 
             RowBox[{"{", "1", ",", "1", "}"}]], " ", "/.", " ", 
            RowBox[{"L2Sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], " ", "===",
        " ", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"FinCurve", ",", 
         SubscriptBox["\[Omega]", "_List"], ",", "\[Infinity]"}], "]"}], " ", 
       "===", " ", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"And", " ", "@@", " ", "ReductionChecks"}]}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";"}], "]"}]], "Input",
 CellLabel->
  "In[438]:=",ExpressionUUID->"c5e92239-dcbe-4b95-9a7a-664fa957d24f"]
}, Closed]],

