Cell[BoxData[RowBox[{"(* List of resolvent labels with reversal symmetry, through level 4. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"varsort", "[", RowBox[{"A_", ",", "i_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"x", ",", "t1", ",", "t2", ",", "B"}], "}"}], ",", RowBox[{RowBox[{"x", "=", RowBox[{"Length", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"B", "=", RowBox[{SubscriptBox["lis", "x"], "\[LeftDoubleBracket]", RowBox[{RowBox[{"i", "+", "1"}], ";;", "All"}], "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", RowBox[{"t1", "=", "A"}], ";", "\[IndentingNewLine]", RowBox[{"t2", "=", RowBox[{"Reverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"MemberQ", "[", RowBox[{"B", ",", "t2"}], "]"}], ",", "0", ",", "t1"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["lis", "1"], "=", RowBox[{"Reverse", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", "i", "}"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", "0"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["lis", "2"], "=", RowBox[{"Reverse", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", "j"}], "}"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["lis", "3"], "=", RowBox[{"Reverse", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", "j", ",", "k"}], "}"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"k", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["lis", "4"], "=", RowBox[{"Reverse", "[", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"k", ",", "0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"l", ",", "1", ",", "1"}], "}"}]}], "]"}], ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["var", "1"], "=", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"varsort", "[", RowBox[{RowBox[{SubscriptBox["lis", "1"], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", "i"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", SubscriptBox["lis", "1"], "]"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["var", "2"], "=", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"varsort", "[", RowBox[{RowBox[{SubscriptBox["lis", "2"], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", "i"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", SubscriptBox["lis", "2"], "]"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["var", "3"], "=", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"varsort", "[", RowBox[{RowBox[{SubscriptBox["lis", "3"], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", "i"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", SubscriptBox["lis", "3"], "]"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["var", "4"], "=", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"varsort", "[", RowBox[{RowBox[{SubscriptBox["lis", "4"], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", "i"}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", SubscriptBox["lis", "4"], "]"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}], ";"}]}]], "Input",
