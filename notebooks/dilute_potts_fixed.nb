Cell[TextData[{
 "Expand the nine sheets as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "\[Rule]", "+", "\[Infinity]"}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"2f82b846-a326-46a2-890c-a84823dc65ac"],
