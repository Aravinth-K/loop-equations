Cell[BoxData[RowBox[{RowBox[{"Timing", "[", RowBox[{RowBox[{"L2Eq", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Cancel", "/@", RowBox[{"(", RowBox[{RowBox[{"Join", "[", RowBox[{RowBox[{"Eq", "\[LeftDoubleBracket]", RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}], ",", RowBox[{"Table", "[", RowBox[{SubscriptBox["Con3", "j"], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"Length", "[", "list2", "]"}]}], "}"}]}], "]"}]}], "]"}], "/.", "\[VeryThinSpace]", RowBox[{"CoEqSol", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"L2Sol", "=", RowBox[{"Solve", "[", RowBox[{RowBox[{RowBox[{"L2Eq", "\[LeftDoubleBracket]", RowBox[{"1", ";;", "2"}], "\[RightDoubleBracket]"}], "\[Equal]", "0"}], ",", RowBox[{"{", RowBox[{SubscriptBox["\[Omega]", RowBox[{"{", "1", "}"}]], ",", SubscriptBox["\[Omega]", RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}]]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"L0Eq", "=", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"DeleteDuplicates", "[", RowBox[{RowBox[{"(", RowBox[{RowBox[{"Numerator", "[", RowBox[{"Together", "[", "#1", "]"}], "]"}], "&"}], ")"}], "/@", RowBox[{"(", RowBox[{"L2Eq", "/.", "\[VeryThinSpace]", RowBox[{"L2Sol", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ")"}]}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"FinCurve", "=", RowBox[{"PolynomialGCD", "@@", "L0Eq"}]}], ";", "\[IndentingNewLine]", RowBox[{"FinCurve", "=", RowBox[{"Collect", "[", RowBox[{RowBox[{"Cancel", "[", FractionBox["FinCurve", RowBox[{"PolynomialGCD", "@@", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[{"CoefficientList", "[", RowBox[{"FinCurve", ",", RowBox[{"{", RowBox[{"z", ",", "\[Omega]"}], "}"}]}], "]"}], "]"}], ",", "0"}], "]"}]}]], "]"}], ",", RowBox[{"{", RowBox[{"\[Omega]", ",", "z"}], "}"}], ",", "Factor"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"L0", "=", RowBox[{"FinCurve", "\[Equal]", "0"}]}], ";"}], "]"}], ";"}]], "Input",
 ExpressionUUID->"2e5c4353-328f-4b2a-b3bd-6e1139ee7eae"]
}, Closed]],

