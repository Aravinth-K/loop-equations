Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["t", "2"], "-", "1"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "2"], "+", 
          SubsuperscriptBox["X", "1", "2"], "+", 
          SubsuperscriptBox["X", "2", "2"]}], ")"}]}], "-", 
       RowBox[{
        SubscriptBox["X", "0"], 
        SubscriptBox["X", "1"]}], "-", 
       RowBox[{
        SubscriptBox["X", "1"], 
        SubscriptBox["X", "2"]}], "-", 
       RowBox[{
        SubscriptBox["X", "2"], 
        SubscriptBox["X", "0"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "3"], "+", 
          SubsuperscriptBox["X", "1", "3"], "+", 
          SubsuperscriptBox["X", "2", "3"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"51663c54-e375-4feb-8636-2ed29ad41da7"],
 ". \nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "a858fc75-437f-4d16-83e5-2341c39dbd8f"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "0"], "+", 
    SubscriptBox["X", "1"]}], TraditionalForm]],ExpressionUUID->
  "3a6d86a3-1d7f-4706-a028-434a84eecd9b"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "1"]}], ",", " ", 
    SubscriptBox["M", "1"], "=", 
    RowBox[{
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}], ",", " ", 
    SubscriptBox["M", "2"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "0cc9d656-d3f2-4987-bf8d-f9e2409a8357"],
 ", the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"3", " ", 
        SubscriptBox["t", "2"]}], "-", "1"}], "4"], " ", 
     SubscriptBox["M", "0"]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", "2"], "+", "1"}], "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["M", "1"], "+", 
       SubscriptBox["M", "2"]}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["M", "0"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["M", "1"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["M", "2"], "2"], "+", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "1"]}], "+", 
       RowBox[{
        SubscriptBox["M", "1"], " ", 
        SubscriptBox["M", "0"]}], "+", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "2"]}], "+", 
       RowBox[{
        SubscriptBox["M", "2"], " ", 
        SubscriptBox["M", "0"]}], "-", 
       RowBox[{"3", " ", 
        SubscriptBox["M", "1"], " ", 
        SubscriptBox["M", "2"]}], "-", 
       RowBox[{"3", " ", 
        SubscriptBox["M", "2"], " ", 
        SubscriptBox["M", "1"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"3f2e2de7-3d5b-4239-81c1-d5b31ecfa402"],
 ". \nThe two selected spin states enter symmetrically: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "0"], "\[LeftRightArrow]", 
    SubscriptBox["X", "1"]}], TraditionalForm]],ExpressionUUID->
  "61f374ae-3d2e-483a-a552-ba7ddd5c8114"],
 " fixes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "b6242cad-fdd3-4713-a8d1-d3803d916a9a"],
 " and exchanges ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "1"], "\[LeftRightArrow]", 
    SubscriptBox["M", "2"]}], TraditionalForm]],ExpressionUUID->
  "2a6c0a55-0af5-47a2-9112-888f75beeb68"],
 ", giving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "4a7e0115-d513-47d1-8f98-a9756e67f2d0"],
 " symmetry used by the modules below. The correlator labels refer to the M \
basis."
}], "Text",ExpressionUUID->"4bdfc19a-e072-40af-ac0d-7f70294ab5dd"]
