        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"2", " ", 
          SubscriptBox["t", "2"]}]}], 
        RowBox[{"8", " ", 
         SubscriptBox["t", "3"]}]]}], ")"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"4", " ", 
          SubscriptBox["t", "2"]}], "-", 
         RowBox[{"4", " ", 
          SubsuperscriptBox["t", "2", "2"]}], "+", 
         RowBox[{"8", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             SubscriptBox["r", "2"], 
             SubscriptBox["r", "3"]], "+", 
            FractionBox[
             SubscriptBox["s", "2"], 
             SubscriptBox["s", "3"]]}], ")"}], " ", 
          SubscriptBox["t", "3"]}]}], ")"}], " ", 
       SqrtBox[
        FractionBox["1", "x"]]}], 
      RowBox[{"32", " ", 
       SqrtBox["2"], " ", 
       SubsuperscriptBox["t", "3", 
        RowBox[{"3", "/", "2"}]]}]], "-", 
     FractionBox["1", 
      RowBox[{"2", " ", "x"}]]}]}], "}"}], ";"}]], "Input",ExpressionUUID->\
"f5993ea7-29e9-4421-9ad7-3eaf5379f9a6"]
