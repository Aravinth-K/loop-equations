  FormBox[
   RowBox[{
    SubscriptBox["t", "0"], ">", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"9d2d6ad8-a66a-4880-bd9d-cf66790c28b5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["t", "3"], ">", "0"}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"09f29627-2c36-4c1c-a7af-c41f37443ff7"],
 ". The leading and splitting coefficients are determined from P, then Newton \
iteration gives the terms displayed below."
}], "Text",ExpressionUUID->"4ef97cd6-6e86-4c4f-a475-83ee578c56d8"],

