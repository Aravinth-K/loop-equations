          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", 
             SubscriptBox["var", "6"], "]"}]}], "}"}]}], "]"}]}], "]"}], "[", 
      
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   " ", 
