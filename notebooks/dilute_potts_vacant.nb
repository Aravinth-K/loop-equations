        RowBox[{
         RowBox[{
         "tempMat", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",",
          "1"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
