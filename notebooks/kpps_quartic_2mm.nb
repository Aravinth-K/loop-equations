Cell[CellGroupData[{

Cell["Asymptotics", "Subsection",ExpressionUUID->"eb6a4429-88e7-4696-93f7-68ec91a0631b"],

Cell["\<\
The physical sheet has leading term 1/z. The signed sector removes odd \
moments, leaving odd inverse powers of z on this sheet.\
\>", "Text",ExpressionUUID->"720838f4-09e5-495b-9413-478842478759"],

Cell[BoxData[
 RowBox[{"Collect", "[", "\[Omega]", " ", "/.", " ", "AsymptoticSolve", "[", 
  "Ppmp", "[", "z", ",", "\[Omega]", "]", " ", "\[Equal]", " ", "0", ",", 
  "\[Omega]", ",", "{", "z", ",", "\[Infinity]", ",", "3", "}", "]", ",", "z",
   ",", "Simplify", "]"}]], "Input",
 CellLabel->
  "In[468]:=",ExpressionUUID->"23577b26-7c94-4e9c-894a-998d39a88ac6"],

Cell[BoxData[
 RowBox[{"sheetspmp", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "z"]}], "+", 
     FractionBox[
      RowBox[{
       FractionBox["1", "g"], "+", 
       RowBox[{
        FractionBox["3", "2"], " ", 
        SubscriptBox["p", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]]}]}], 
      SuperscriptBox["z", "3"]], "-", 
     FractionBox[
      SqrtBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        RowBox[{"2", " ", "g", " ", 
         SubscriptBox["p", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]]}]}]], 
      RowBox[{
       SqrtBox["g"], " ", 
       SuperscriptBox["z", "2"]}]]}], ",", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "z"]}], "+", 
     FractionBox[
      RowBox[{
       FractionBox["1", "g"], "+", 
       RowBox[{
        FractionBox["3", "2"], " ", 
        SubscriptBox["p", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]]}]}], 
      SuperscriptBox["z", "3"]], "+", 
     FractionBox[
      SqrtBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        RowBox[{"2", " ", "g", " ", 
         SubscriptBox["p", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]]}]}]], 
      RowBox[{
       SqrtBox["g"], " ", 
       SuperscriptBox["z", "2"]}]]}], ",", 
    RowBox[{
     FractionBox["1", "z"], "+", 
     FractionBox[
      SubscriptBox["p", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]], 
      SuperscriptBox["z", "3"]]}], ",", 
    RowBox[{"g", " ", 
     SuperscriptBox["z", "3"]}]}], "}"}]}]], "Input",
 CellLabel->
  "In[469]:=",ExpressionUUID->"4dc1dcad-c8aa-4a16-9205-28096f808d98"]
