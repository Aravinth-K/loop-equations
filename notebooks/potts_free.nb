Cell["The Action", "Section",ExpressionUUID->"0b97d0f0-87c2-4749-85c5-a41973e5ce5e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["t", "2"], "-", "1"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "2"], "+", 
          SubsuperscriptBox["X", "1", "2"], "+", 
          SubsuperscriptBox["X", "2", "2"]}], ")"}]}], "-", 
       RowBox[{
        SubscriptBox["X", "0"], 
        SubscriptBox["X", "1"]}], "-", 
       RowBox[{
        SubscriptBox["X", "1"], 
        SubscriptBox["X", "2"]}], "-", 
       RowBox[{
        SubscriptBox["X", "2"], 
        SubscriptBox["X", "0"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "3"], "+", 
          SubsuperscriptBox["X", "1", "3"], "+", 
          SubsuperscriptBox["X", "2", "3"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"51663c54-e375-4feb-8636-2ed29ad41da7"],
 ". \nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "3322abc3-1128-4e6e-950b-d42862e215fd"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "0"], "+", 
    SubscriptBox["X", "1"], "+", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "2154e74f-9ce2-4003-a329-fff9df77e11e"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}], ",", " ", 
    SubscriptBox["M", "1"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "-", 
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}], ",", " ", 
    SubscriptBox["M", "2"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "1"], "-", 
     SubscriptBox["X", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "8502c950-e5e2-4e9c-bf5e-89e2c7201ff5"],
 ", the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "4"], " ", 
     SuperscriptBox[
      SubscriptBox["M", "0"], "2"]}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["t", "2"], "-", "2"}], "2"], " ", 
     SubscriptBox["M", "0"]}], "-", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "2"], "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["M", "1"], "+", 
       SubscriptBox["M", "2"]}], ")"}]}], "-", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "1"]}], "+", 
       RowBox[{
        SubscriptBox["M", "1"], " ", 
        SubscriptBox["M", "0"]}], "+", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "2"]}], "+", 
       RowBox[{
        SubscriptBox["M", "2"], " ", 
        SubscriptBox["M", "0"]}]}], ")"}]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["M", "1"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["M", "2"], "2"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"555e1e13-5879-46d0-995e-e151fc9ec315"],
 ". \nAll three spin states enter symmetrically. Exchanging ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "1"], "\[LeftRightArrow]", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "83eeaa27-b999-40a0-8ae1-dda4c6292276"],
 " swaps ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "1"], "\[LeftRightArrow]", 
    SubscriptBox["M", "2"]}], TraditionalForm]],ExpressionUUID->
  "f9d1e2f4-b6c7-47a9-a69d-d97ddcd95506"],
 ", giving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "634b4ca8-fb7c-4c9f-b557-3b0549279114"],
 " symmetry used by the word-label modules. \nThe full ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "21f67f78-7a89-439e-add9-095265e25e62"],
 " symmetry of the insertion also gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     RowBox[{"{", "1", "}"}]], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"z", " ", "\[Omega]"}], "-", "1"}], "3"]}], TraditionalForm]],
  ExpressionUUID->"f2193d88-0a54-449c-a886-2cb5510c823f"],
 ", used in the loop equations below. \nCorrelator labels refer to the M \
basis."
}], "Text",
