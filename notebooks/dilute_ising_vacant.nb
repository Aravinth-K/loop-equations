              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", "\[Rule]", "2"}], ",", 
                RowBox[{"2", "\[Rule]", "1"}]}], "}"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
