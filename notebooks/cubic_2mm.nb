Cell[BoxData[RowBox[{"(* Expand insertions of M0 against the resolvent. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"\[CapitalDelta]", "[", RowBox[{"A_", ",", "n_"}], "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"n", "\[Equal]", "0"}], ",", SubscriptBox["\[Omega]", RowBox[{RowBox[{"sortL", "[", "A", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]], ",", RowBox[{RowBox[{SuperscriptBox["z", "n"], " ", SubscriptBox["\[Omega]", RowBox[{RowBox[{"sortL", "[", "A", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]]}], "-", RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"i", "=", "1"}], "n"], RowBox[{SuperscriptBox["z", RowBox[{"n", "-", "i"}]], " ", SubscriptBox["p", RowBox[{"cosort", "[", RowBox[{"Flatten", "[", RowBox[{"Append", "[", RowBox[{RowBox[{RowBox[{"sortL", "[", "A", "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", RowBox[{"Table", "[", RowBox[{"0", ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"i", "-", "1"}]}], "}"}]}], "]"}]}], "]"}], "]"}], "]"}]]}]}]}]}], "]"}]}], ";"}]}]], "Input",
