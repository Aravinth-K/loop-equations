Cell["KPPS Cubic 3-Matrix Model", "Title",ExpressionUUID->"04413215-ac20-4d03-b8e7-4a4944afa272"],

Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"4789bc65-e729-4da9-a46d-dadf5aac45f7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["M", "0", "2"], "+", 
          SubsuperscriptBox["M", "1", "2"], "+", 
          SubsuperscriptBox["M", "2", "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["g", "3"], " ", 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["M", "0", "3"], "+", 
          SubsuperscriptBox["M", "1", "3"], "+", 
          SubsuperscriptBox["M", "2", "3"]}], ")"}]}], "+", 
       RowBox[{"g", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["M", "0"], " ", 
           SubscriptBox["M", "1"], " ", 
           SubscriptBox["M", "2"]}], "+", 
          RowBox[{
           SubscriptBox["M", "0"], " ", 
           SubscriptBox["M", "2"], " ", 
           SubscriptBox["M", "1"]}]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"c039721f-b017-4868-a437-54a97b7383e7"],
 ". \nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "ba1413ed-d523-44a6-a109-d4b0bad0c81d"],
 ", so the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "+", 
    RowBox[{"g", " ", 
     SubsuperscriptBox["M", "0", "2"]}], "+", 
    RowBox[{"g", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["M", "1"], " ", 
        SubscriptBox["M", "2"]}], "+", 
       RowBox[{
        SubscriptBox["M", "2"], " ", 
        SubscriptBox["M", "1"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"e0ed2077-9c94-442b-b645-381cf14aa7e0"],
 ". \nThe remaining two matrices enter symmetrically, giving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "5fe971c6-c453-4fc7-961b-9853c795348b"],
 " symmetry used by the resolvent modules below. The correlators retain the \
full ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "3"], TraditionalForm]],ExpressionUUID->
  "e719f25a-c04c-4f8e-9f00-d935b0fd5880"],
 " symmetry of the action."
}], "Text",ExpressionUUID->"2d928453-6b20-49c0-a58b-6d16c8acbadc"]
}, Closed]],

