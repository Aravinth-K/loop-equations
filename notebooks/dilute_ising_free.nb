            RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}], ")"}]}], ",", "1",
          ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "tempMat", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "list1", "]"}], " ", "=!=", " ", 
      RowBox[{"Length", "[", "L2Variables", "]"}]}], ",", 
