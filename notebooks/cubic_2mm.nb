Cell["The Action", "Section",
 ExpressionUUID->"abdeb05e-5449-4068-a87e-2524ff4c8319"],

Cell[TextData[{Cell[BoxData[FormBox[RowBox[{SubscriptBox["S", "N"], "=", "N", " ", RowBox[{"Tr", "(", RowBox[{FractionBox[RowBox[{"\[Alpha]", " ", SuperscriptBox[SubscriptBox["M", "0"], "2"], "-", "2", " ", "\[Gamma]", " ", SubscriptBox["M", "0"], " ", SubscriptBox["M", "1"], "+", "\[Beta]", " ", SuperscriptBox[SubscriptBox["M", "1"], "2"]}], RowBox[{"2", " ", RowBox[{"(", RowBox[{"\[Alpha]", " ", "\[Beta]", "-", SuperscriptBox["\[Gamma]", "2"]}], ")"}]}]], "-", FractionBox[RowBox[{"a", " ", SuperscriptBox[SubscriptBox["M", "0"], "3"], "+", "3", " ", "b", " ", SuperscriptBox[SubscriptBox["M", "0"], "2"], " ", SubscriptBox["M", "1"], "+", "3", " ", "d", " ", SubscriptBox["M", "0"], " ", SuperscriptBox[SubscriptBox["M", "1"], "2"], "+", "e", " ", SuperscriptBox[SubscriptBox["M", "1"], "3"]}], "3"]}], ")"}]}], TraditionalForm]], "InlineFormula"], ".\n\nResolvent taken over ", Cell[BoxData[FormBox[SubscriptBox["M", "0"], TraditionalForm]], "InlineFormula"], ", so the derivative of the action entering K0 is ", Cell[BoxData[FormBox[RowBox[{FractionBox[RowBox[{"\[Alpha]", " ", SubscriptBox["M", "0"], "-", "\[Gamma]", " ", SubscriptBox["M", "1"]}], RowBox[{"\[Alpha]", " ", "\[Beta]", "-", SuperscriptBox["\[Gamma]", "2"]}]], "-", "a", " ", SuperscriptBox[SubscriptBox["M", "0"], "2"], "-", "b", " ", RowBox[{"(", RowBox[{SubscriptBox["M", "0"], " ", SubscriptBox["M", "1"], "+", SubscriptBox["M", "1"], " ", SubscriptBox["M", "0"]}], ")"}], "-", "d", " ", SuperscriptBox[SubscriptBox["M", "1"], "2"]}], TraditionalForm]], "InlineFormula"], ".\nResolvent words are identified under reversal, and correlator words under cyclic permutation and reversal. The two matrices have no exchange symmetry for generic couplings."}], "Text",
 ExpressionUUID->"c48e5767-7cb9-4880-8400-7833e1ac9fb4"]
}, Open]],

