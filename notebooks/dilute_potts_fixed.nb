Cell[CellGroupData[{
Cell["Loop Equations for Fixed-Boundary Dilute 3-Potts", "Title",ExpressionUUID->"f4aa447c-6e57-4f32-95c5-d72be3343bc7"],

Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"c63a3c99-ff5b-4578-a94f-6621605cc05d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       FractionBox[
        SubscriptBox["t", "2"], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["X", "0"], "2"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "1"], "2"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "2"], "2"]}], ")"}], "+", 
       FractionBox["1", "2"], " ", 
       SuperscriptBox[
        SubscriptBox["X", "3"], "2"], "-", 
       SubscriptBox["X", "3"], " ", 
       SubscriptBox["X", "0"], "-", 
       SubscriptBox["X", "3"], " ", 
       SubscriptBox["X", "1"], "-", 
       SubscriptBox["X", "3"], " ", 
       SubscriptBox["X", "2"], "+", 
       FractionBox[
        SubscriptBox["t", "3"], "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["X", "0"], "3"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "1"], "3"], "+", 
         SuperscriptBox[
          SubscriptBox["X", "2"], "3"]}], ")"}], "+", 
       FractionBox[
        SubscriptBox["t", "0"], "3"], " ", 
       SuperscriptBox[
        SubscriptBox["X", "3"], "3"]}], ")"}]}]}], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"89dcb946-11bd-4f13-938f-2b591de57371"],
 ".\n\nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "72e1725a-0585-4c73-bcae-fbf7de22164b"],
 ", with vacancy matrix ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "3"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "830faad4-fa23-4ebc-a670-9709bf1d80b5"],
 ", so the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["t", "3"], " ", 
     SubsuperscriptBox["X", "0", "2"]}], "+", 
    RowBox[{
     SubscriptBox["t", "2"], " ", 
     SubscriptBox["X", "0"]}], "-", 
    SubscriptBox["X", "3"]}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"e7b88c20-ed98-444b-9a33-e9b725ea60de"],
 ".\nThe remaining two spin states enter symmetrically, giving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8aa3f1f0-a203-4448-94ba-4798260a9920"],
 " symmetry used by the modules below."
}], "Text",ExpressionUUID->"74dd2077-1a48-41ce-bec4-86eb13c06f07"]
}, Closed]],

