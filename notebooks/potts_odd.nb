Cell["The Action", "Section",ExpressionUUID->"191d7dab-b621-487c-8f3f-223d75315e23"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["t", "2"], "-", "1"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "2"], "+", 
          SubsuperscriptBox["X", "1", "2"], "+", 
          SubsuperscriptBox["X", "2", "2"]}], ")"}]}], "-", 
       RowBox[{
        SubscriptBox["X", "0"], 
        SubscriptBox["X", "1"]}], "-", 
       RowBox[{
        SubscriptBox["X", "1"], 
        SubscriptBox["X", "2"]}], "-", 
       RowBox[{
        SubscriptBox["X", "2"], 
        SubscriptBox["X", "0"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "3"], "+", 
          SubsuperscriptBox["X", "1", "3"], "+", 
          SubsuperscriptBox["X", "2", "3"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"51663c54-e375-4feb-8636-2ed29ad41da7"],
 ". \nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["M", "0"], TraditionalForm]],ExpressionUUID->
  "d47209af-cc0a-441d-b1be-27954dc12dd3"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "0"], "-", 
    SubscriptBox["X", "1"], "+", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "46e9f2c6-5013-40cd-bd52-e2430a9bfa56"],
 ". With ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "-", 
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}], ",", " ", 
    SubscriptBox["M", "1"], "=", 
    RowBox[{"-", 
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}], ",", " ", 
    SubscriptBox["M", "2"], "=", 
    RowBox[{
     SubscriptBox["X", "0"], "+", 
     SubscriptBox["X", "1"], "+", 
     SubscriptBox["X", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "49092b68-781d-47eb-81a9-62fb5725d190"],
 ", the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      SubscriptBox["t", "2"], "2"], " ", 
     SubscriptBox["M", "0"]}], "-", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "2"], "4"], " ", 
     SubscriptBox["M", "2"]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "2"], "4"], " ", 
     SubscriptBox["M", "1"]}], "+", 
    RowBox[{
     FractionBox[
      SubscriptBox["t", "3"], "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["M", "2"], " ", 
        SubscriptBox["M", "0"]}], "+", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "2"]}], "+", 
       RowBox[{
        SubscriptBox["M", "1"], " ", 
        SubscriptBox["M", "0"]}], "+", 
       RowBox[{
        SubscriptBox["M", "0"], " ", 
        SubscriptBox["M", "1"]}], "-", 
       SuperscriptBox[
        SubscriptBox["M", "2"], "2"], "+", 
       SuperscriptBox[
        SubscriptBox["M", "1"], "2"]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"4237b8be-4ccb-49f7-9315-0fde62147383"],
 ". \nThe correlator modules use ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["M", "0"], "\[LeftRightArrow]", 
    SubscriptBox["M", "1"]}], TraditionalForm]],ExpressionUUID->
  "75a95de0-d56c-4d84-9b5f-33f81df2838d"],
 " symmetry, while the resolvent word list factors reversal. \nExchanging ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["X", "0"], "\[LeftRightArrow]", 
    SubscriptBox["X", "2"]}], TraditionalForm]],ExpressionUUID->
  "17b67791-2ef3-482e-8455-ba980afce136"],
 " leaves the insertion fixed and gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", 
     RowBox[{"{", "2", "}"}]], "=", 
    RowBox[{"2", " ", 
     SubscriptBox["\[Omega]", 
      RowBox[{"{", "1", "}"}]]}], "+", 
    RowBox[{"z", " ", "\[Omega]"}], "-", "1"}], TraditionalForm]],
  ExpressionUUID->"91cc7e5a-3c4a-4d96-9d7f-73741eb5c96a"],
 ", used in the loop equations below. \nCorrelator labels refer to the M \
basis."
}], "Text",
