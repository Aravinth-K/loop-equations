[{RowBox[{"y", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", "1"}]}], "\[RightDoubleBracket]"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{"A", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"A", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", RowBox[{RowBox[{RowBox[{"y", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+", "1"}], ";;", "All"}], "\[RightDoubleBracket]"}]}], "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{RowBox[{"A", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", RowBox[{RowBox[{RowBox[{"y", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "+", "1"}], ";;", "All"}], "\[RightDoubleBracket]"}], ",", RowBox[{"Join", "[", RowBox[{RowBox[{RowBox[{"A", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", RowBox[{"1", ";;", RowBox[{RowBox[{"y", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "-", "1"}]}], "\[RightDoubleBracket]"}], ",", RowBox[{"A", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"r", "=", RowBox[{"g", "/@", "x"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"s", "[", RowBox[{"B_", ",", "n_"}], "]"}], ":=", RowBox[{SubscriptBox["p", RowBox[{"cosort", "[", RowBox[{"B", "\[LeftDoubleBracket]", RowBox[{"n", ",", "1"}], "\[RightDoubleBracket]"}], "]"}]], " ", SubscriptBox["p", RowBox[{"cosort", "[", RowBox[{"Flatten", "[", RowBox[{"Append", "[", RowBox[{RowBox[{RowBox[{"sortL", "[", RowBox[{"B", "\[LeftDoubleBracket]", RowBox[{"n", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",", RowBox[{"Table", "[", RowBox[{"0", ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"Length", "[", RowBox[{RowBox[{"sortL", "[", RowBox[{"B", "\[LeftDoubleBracket]", RowBox[{"n", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracke