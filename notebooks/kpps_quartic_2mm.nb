Cell[CellGroupData[{

Cell["Asymptotics", "Subsection",ExpressionUUID->"fbe06e01-772c-470b-9062-2bc74950c740"],

Cell["\<\
The physical sheet has leading term 1/z. The signed sector removes odd \
moments, leaving odd inverse powers of z on this sheet.\
\>", "Text",ExpressionUUID->"16f46a31-dfa8-47da-ae8b-e0da525ede9e"],

Cell[BoxData[
 RowBox[{"Collect", "[", "\[Omega]", " ", "/.", " ", "AsymptoticSolve", "[", 
  "Pppp", "[", "z", ",", "\[Omega]", "]", " ", "\[Equal]", " ", "0", ",", 
  "\[Omega]", ",", "{", "z", ",", "\[Infinity]", ",", "3", "}", "]", ",", "z",
   ",", "Simplify", "]"}]], "Input",
 CellLabel->
  "In[440]:=",ExpressionUUID->"38e36cfb-21b9-481e-9de5-28100b66cdb1"],

Cell[BoxData[
 RowBox[{"sheetsppp", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
