Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "List", " ", "of", " ", "correlator", " ", "labels", " ", "with", " ", 
    "S_", "3", " ", "symmetry", " ", 
    RowBox[{"factored", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
