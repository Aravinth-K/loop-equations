Cell[BoxData[RowBox[{"(* List of correlator labels with cyclic and reversal symmetry, through level 3. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"covarlist", "[", "n_", "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"x", ",", "y", ",", "g"}], "}"}], ",", RowBox[{RowBox[{"x", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{SubscriptBox["i", "j"], ",", "0", ",", "1"}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"y", "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Table", "[", RowBox[{SubscriptBox["i", "j"], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", RowBox[{"Evaluate", "[", RowBox[{"Sequence", "@@", "x"}], "]"}]}], "]"}], ",", RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{RowBox[{"g", "[", RowBox[{"A_", ",", "i_"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", "B", "}"}], ",", RowBox[{RowBox[{"B", "=", RowBox[{"y", "\[LeftDoubleBracket]", RowBox[{"1", ";;", "i"}], "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}]], "=", "A"}], ";", "\[IndentingNewLine]", RowBox[{"For", "[", RowBox[{RowBox[{"j", "=", "2"}], ",", RowBox[{"j", "\[LessEqual]", "n"}], ",", RowBox[{"j", "++"}], ",", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"1", ",", "j"}], "}"}]], "=", RowBox[{"RotateRight", "[", SubscriptBox["l", RowBox[{"{", RowBox[{"1", ",", RowBox[{"j", "-", "1"}]}], "}"}]], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"2", ",", "1"}], "}"}]], "=", RowBox[{"Reverse", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"For", "[", RowBox[{RowBox[{"j", "=", "2"}], ",", RowBox[{"j", "\[LessEqual]", "n"}], ",", RowBox[{"j", "++"}], ",", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"2", ",", "j"}], "}"}]], "=", RowBox[{"RotateRight", "[", SubscriptBox["l", RowBox[{"{", RowBox[{"2", ",", RowBox[{"j", "-", "1"}]}], "}"}]], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"If", "[", RowBox[{RowBox[{"IntersectingQ", "[", RowBox[{"B", ",", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Join", "[", RowBox[{"{", RowBox[{RowBox[{"Table", "[", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"1", ",", "j"}], "}"}]], ",", RowBox[{"{", RowBox[{"j", ",", "2", ",", "n"}], "}"}]}], "]"}], ",", RowBox[{"Table", "[", RowBox[{SubscriptBox["l", RowBox[{"{", RowBox[{"2", ",", "j"}], "}"}]], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "}"}], "]"}], ",", "1"}], "]"}]}], "]"}], ",", "0", ",", SubscriptBox["l", RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}]]}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"g", "[", RowBox[{RowBox[{"y", "\[LeftDoubleBracket]", RowBox[{RowBox[{"Length", "[", "y", "]"}], "+", "1", "-", "i"}], "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"Length", "[", "y", "]"}], "-", "i"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "y", "]"}]}], "}"}]}], "]"}], ",", "0"}], "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{SubscriptBox["covar", "n"], "=", RowBox[{"covarlist", "[", "n", "]"}]}], ",", RowBox[{"{", RowBox[{"n", ",", "1", ",", "3"}], "}"}]}], "]"}], ";"}]}]], "Input",
