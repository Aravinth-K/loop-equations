Cell[CellGroupData[{

Cell["Level 5 Constraints", "Section",
 CellChangeTimes->{{3.795286935872165*^9, 
  3.7952869379061313`*^9}},ExpressionUUID->"a173af19-b0d4-45d8-ad28-\
7fa6c31b90db"],

Cell[TextData[{
 StyleBox["Perform the following :\n  1. Tabulates the relevant equations at \
this level .\n  2. Compute the matrix of coefficients for the level 5 \
resolvent functions .\n  3. Row - reduce the transpose of the coefficient \
matrix . \n  4. Reading off the column numbers of the first ' 1' entry in \
each row indicates the linearly independent set of equations .\n  5. Find the \
set of coefficients such that you can write the linearly independent \
equations in terms of the found basis .\n  6. Eliminate level 5 resolvent \
functions leaving only constraints on lower order functions .", "Text",
  FontWeight->"Plain"],
 StyleBox["\n     ", "Text"]
}], "Input",
 CellChangeTimes->{
  3.800686193859239*^9, {3.800686288757872*^9, 3.800686343908152*^9}, {
   3.997827893516398*^9, 3.997828082242496*^9}, {3.997828207382337*^9, 
   3.997828223688386*^9}},
 FormatType->"TextForm",
 CellLabel->
  "In[101]:=",ExpressionUUID->"bd8be28c-ed61-4b66-987e-6ec482bab161"],

Cell[BoxData[
 RowBox[{"Timing", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"L5Eq", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Eq", "[", 
       RowBox[{"[", "j", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "21", ",", "64"}], "}"}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"CoMat5", "=", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"CoefficientArrays", "[", 
       RowBox[{"L5Eq", ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          SubscriptBox["\[Omega]", 
           RowBox[{
            SubscriptBox["var", "5"], "[", 
            RowBox[{"[", "i", "]"}], "]"}]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", 
             SubscriptBox["var", "5"], "]"}]}], "}"}]}], "]"}]}], "]"}], "[", 
      
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"tempMat", "=", 
    RowBox[{"RowReduce", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Transpose", "[", "CoMat5", "]"}], "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"list0", "=", 
    RowBox[{"{", "}"}]}], ";", " ", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"list0", ",", 
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"tempMat", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", 
         "1"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"Length", "[", "tempMat", "]"}]}], "}"}]}], "]"}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"list1", "=", 
    RowBox[{"Flatten", "[", "list0", "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"list0", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "L5Eq", "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"list2", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{"list0", ",", "list1"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Do", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             SubscriptBox["a", "i"], 
             RowBox[{"CoMat5", "[", 
              RowBox[{"[", 
               RowBox[{"Part", "[", 
                RowBox[{"list1", ",", "i"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}], "\[Equal]", 
          RowBox[{"CoMat5", "[", 
           RowBox[{"[", 
            RowBox[{"Part", "[", 
             RowBox[{"list2", ",", "j"}], "]"}], "]"}], "]"}]}], " ", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           SubscriptBox["a", "i"], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\t", 
      RowBox[{
       SubscriptBox["Con5", "j"], "=", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              SubscriptBox["a", "i"], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}], "/.", 
            RowBox[{"x", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], ".", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"L5Eq", "[", 
             RowBox[{"[", 
              RowBox[{"list1", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}]}], "-", 
         
         RowBox[{"L5Eq", "[", 
          RowBox[{"[", 
           RowBox[{"list2", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"Length", "[", "list2", "]"}]}], "}"}]}], "]"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.7949074837243686`*^9, 3.7949074859861727`*^9}, {
