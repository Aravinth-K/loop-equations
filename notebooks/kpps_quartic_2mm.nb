Cell[CellGroupData[{

Cell["Asymptotics", "Subsection",ExpressionUUID->"ed49c50a-66f2-4e2d-880e-48eedebbb75b"],

Cell["\<\
The physical sheet has leading term 1/z. The signed sector removes odd \
moments, leaving odd inverse powers of z on this sheet.\
\>", "Text",ExpressionUUID->"de8fdcda-af21-4bf8-ae12-5a5e0e7f7bc6"],

Cell[BoxData[
 RowBox[{"Collect", "[", "\[Omega]", " ", "/.", " ", "AsymptoticSolve", "[", 
  "Pppm", "[", "z", ",", "\[Omega]", "]", " ", "\[Equal]", " ", "0", ",", 
  "\[Omega]", ",", "{", "z", ",", "\[Infinity]", ",", "3", "}", "]", ",", "z",
   ",", "Simplify", "]"}]], "Input",
 CellLabel->
  "In[529]:=",ExpressionUUID->"7d61919f-5979-480c-8f43-6c5c43c0f48a"],

Cell[BoxData[
 RowBox[{"sheetsppm", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     FractionBox["1", "z"], "+", 
     FractionBox[
      SubscriptBox["p", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]], 
      SuperscriptBox["z", "3"]]}], ",", 
    RowBox[{"g", " ", 
     SuperscriptBox["z", "3"]}], ",", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "z"]}], "+", 
     RowBox[{"3", " ", "z"}]}], ",", 
    RowBox[{
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"2", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", "g"]}], ")"}], 
       RowBox[{"2", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", "z"], ")"}], 
       RowBox[{"1", "/", "3"}]]}], "-", 
     FractionBox["1", 
      RowBox[{"3", " ", "z"}]], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", "-", 
        RowBox[{"2", " ", 
         SuperscriptBox["2", 
          RowBox[{"1", "/", "3"}]], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"-", 
            FractionBox["1", "g"]}], ")"}], 
          RowBox[{"1", "/", "3"}]], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["1", "z"], ")"}], 
          RowBox[{"2", "/", "3"}]]}]}], ")"}], " ", "z"}]}], ",", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "2"}], ")"}], 
       RowBox[{"2", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", 
         FractionBox["1", "g"]}], ")"}], 
       RowBox[{"2", "/", "3"}]], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["1", "z"], ")"}], 
       RowBox[{"1", "/", "3"}]]}], "-", 
