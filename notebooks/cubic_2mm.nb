x["a", "i"], " ", RowBox[{"CoMat4", "\[LeftDoubleBracket]", RowBox[{"list1", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}]}], "\[Equal]", RowBox[{"CoMat4", "\[LeftDoubleBracket]", RowBox[{"list2", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], ",", RowBox[{"Table", "[", RowBox[{SubscriptBox["a", "i"], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["Con4", "j"], "=", RowBox[{"Simplify", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"Table", "[", RowBox[{SubscriptBox["a", "i"], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}], "/.", "\[VeryThinSpace]", RowBox[{"x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ")"}], ".", RowBox[{"Table", "[", RowBox[{RowBox[{"L4Eq", "\[LeftDoubleBracket]", RowBox[{"list1", "\[LeftDoubleBracket]", "k", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[{"k", ",", "1", ",", RowBox[{"Length", "[", "list1", "]"}]}], "}"}]}], "]"}]}], "-", RowBox[{"L4Eq", "\[LeftDoubleBracket]", RowBox[{"list2", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], "]"}]}], ";"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"Length", "[", "list2", "]"}]}], "}"}]}], "]"}]}], "]"}], ";"}]], "Input",
