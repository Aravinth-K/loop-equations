Cell[BoxData[RowBox[{"(* Sort a correlator label to its cyclic and reversal representative. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"cosort", "[", "A_", "]"}], ":=", RowBox[{"If", "[", RowBox[{RowBox[{"A", "\[Equal]", RowBox[{"{", "}"}]}], ",", RowBox[{"{", "}"}], ",", RowBox[{"SelectFirst", "[", RowBox[{RowBox[{"Join", "[", RowBox[{RowBox[{"NestList", "[", RowBox[{"RotateRight", ",", "A", ",", RowBox[{RowBox[{"Length", "[", "A", "]"}], "-", "1"}]}], "]"}], ",", RowBox[{"NestList", "[", RowBox[{"RotateRight", ",", RowBox[{"Reverse", "[", "A", "]"}], ",", RowBox[{RowBox[{"Length", "[", "A", "]"}], "-", "1"}]}], "]"}]}], "]"}], ",", RowBox[{RowBox[{"MemberQ", "[", RowBox[{SubscriptBox["covar", RowBox[{"Length", "[", "A", "]"}]], ",", "#1"}], "]"}], "&"}]}], "]"}]}], "]"}]}], ";"}]}]], "Input",
