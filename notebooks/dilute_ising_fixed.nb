   RowBox[{"L1Linear", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"L1Eq", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"CoefficientArrays", "[", 
          RowBox[{
           RowBox[{"{", "#", "}"}], ",", "L1Variables"}], "]"}], "]"}], " ", "<=",
         " ", "2"}], " ", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"CoMat1", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"CoefficientArrays", "[", 
       RowBox[{"L1Linear", ",", "L1Variables"}], "]"}], "[", 
