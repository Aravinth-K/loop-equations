Cell[CellGroupData[{

Cell["The Action", "Section",ExpressionUUID->"4789bc65-e729-4da9-a46d-dadf5aac45f7"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "N"], "=", 
    RowBox[{"N", " ", 
     RowBox[{"Tr", "(", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{
          SubscriptBox["t", "2"], "-", "1"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "2"], "+", 
          SubsuperscriptBox["X", "1", "2"], "+", 
          SubsuperscriptBox["X", "2", "2"]}], ")"}]}], "-", 
       RowBox[{
        SubscriptBox["X", "0"], 
        SubscriptBox["X", "1"]}], "-", 
       RowBox[{
        SubscriptBox["X", "1"], 
        SubscriptBox["X", "2"]}], "-", 
       RowBox[{
        SubscriptBox["X", "2"], 
        SubscriptBox["X", "0"]}], "+", 
       RowBox[{
        FractionBox[
         SubscriptBox["t", "3"], "3"], 
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["X", "0", "3"], "+", 
          SubsuperscriptBox["X", "1", "3"], "+", 
          SubsuperscriptBox["X", "2", "3"]}], ")"}]}]}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"51663c54-e375-4feb-8636-2ed29ad41da7"],
 ". \nResolvent taken over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "0"], TraditionalForm]],ExpressionUUID->
  "45aad910-53c4-480f-908f-790edb2f8081"],
 ", so the derivative of the action entering K0 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["t", "2"], "-", "1"}], ")"}], 
    SubscriptBox["X", "0"], "-", 
    SubscriptBox["X", "1"], "-", 
    SubscriptBox["X", "2"], "+", 
    SubscriptBox["t", "3"], 
    SubsuperscriptBox["X", "0", "2"]}], TraditionalForm]],ExpressionUUID->
  "6b5bc74c-0769-4668-a7bd-3495b1643acb"],
 ". \nRemaining two spin states enter symmetrically, giving the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "440050a3-e897-4f45-a7a2-68ce6e23faad"],
 " symmetry used by the modules below."
}], "Text",
 CellChangeTimes->{{3.997826889784103*^9, 3.9978269221761713`*^9}, {
  3.997828199002379*^9, 
  3.997828200128077*^9}},ExpressionUUID->"a0bd2964-b6b6-44fa-8497-\
22dd52bd71d7"]
}, Closed]],

