Cell[BoxData[RowBox[{"(* Generate resolvent loop equations through level 2. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{"\[Delta]", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{RowBox[{"{", "}"}], ",", RowBox[{"{", "}"}]}], "}"}], "}"}], ",", RowBox[{"var", "[", "1", "]"}], ",", RowBox[{"var", "[", "2", "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", RowBox[{"While", "[", RowBox[{RowBox[{"i", "\[LessEqual]", RowBox[{"Length", "[", "\[Delta]", "]"}]}], ",", RowBox[{RowBox[{SubscriptBox["L", RowBox[{"{", RowBox[{"i", ",", "0"}], "}"}]], "=", RowBox[{RowBox[{"K0", "[", RowBox[{"\[Delta]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}], "-", RowBox[{"J0", "[", RowBox[{"\[Delta]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}]}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["L", RowBox[{"{", RowBox[{"i", ",", "1"}], "}"}]], "=", RowBox[{RowBox[{"K1", "[", RowBox[{"\[Delta]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}], "-", RowBox[{"J1", "[", RowBox[{"\[Delta]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"Eq", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Simplify", "[", SubscriptBox["L", RowBox[{"{", RowBox[{"j", ",", "i"}], "}"}]], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"Length", "[", "\[Delta]", "]"}]}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}]}]], "Input",
 ExpressionUUID->"03b23e3a-c556-4882-8417-42021904e833"],

Cell[BoxData[RowBox[{"(* Solve the trace equations for the empty word and each one-letter word. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{"\[Epsilon]", "=", RowBox[{"Join", "[", RowBox[{RowBox[{"{", RowBox[{"{", RowBox[{RowBox[{"{", "}"}], ",", RowBox[{"{", "}"}]}], "}"}], "}"}], ",", RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", "j", "}"}], ",", RowBox[{"{", "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"j", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", RowBox[{"While", "[", RowBox[{RowBox[{"i", "\[LessEqual]", RowBox[{"Length", "[", "\[Epsilon]", "]"}]}], ",", RowBox[{RowBox[{SubscriptBox["H", RowBox[{"{", RowBox[{"i", ",", "0"}], "}"}]], "=", RowBox[{"p0", "[", RowBox[{"\[Epsilon]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{SubscriptBox["H", RowBox[{"{", RowBox[{"i", ",", "1"}], "}"}]], "=", RowBox[{"p1", "[", RowBox[{"\[Epsilon]", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"i", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"CoEq", "=", RowBox[{"DeleteDuplicates", "[", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Table", "[", RowBox[{RowBox[{"Simplify", "[", SubscriptBox["H", RowBox[{"{", RowBox[{"j", ",", "i"}], "}"}]], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", RowBox[{"Length", "[", "\[Epsilon]", "]"}]}], "}"}]}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"coList", "=", RowBox[{"Reverse", "[", RowBox[{"Flatten", "[", RowBox[{"Table", "[", RowBox[{RowBox[{"Table", "[", RowBox[{SubscriptBox["p", RowBox[{SubscriptBox["covar", "j"], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", SubscriptBox["covar", "j"], "]"}]}], "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"M", "=", RowBox[{"Normal", "[", RowBox[{RowBox[{"CoefficientArrays", "[", RowBox[{RowBox[{"CoEq", "\[Equal]", "0"}], ",", "coList"}], "]"}], "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"tempMat", "=", RowBox[{"RowReduce", "[", "M", "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"lis", "=", RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", RowBox[{"Do", "[", RowBox[{RowBox[{"AppendTo", "[", RowBox[{"lis", ",", RowBox[{"Position", "[", RowBox[{RowBox[{"tempMat", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",", RowBox[{"_", "?", RowBox[{"(", RowBox[{RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", "1"}], "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", "M", "]"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", RowBox[{"pList", "=", RowBox[{"Table", "[", RowBox[{RowBox[{"coList", "\[LeftDoubleBracket]", RowBox[{RowBox[{"Flatten", "[", RowBox[{"lis", ",", "2"}], "]"}], "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{"Length", "[", RowBox[{"Flatten", "[", RowBox[{"lis", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", RowBox[{"CoEqSol", "=", RowBox[{"Solve", "[", RowBox[{RowBox[{"CoEq", "\[Equal]", "0"}], ",", "pList"}], "]"}]}], ";"}]}]], "Input",
 ExpressionUUID->"074a2a9b-6d88-497b-b38d-cae7ff9c23ed"]
}, Closed]],

