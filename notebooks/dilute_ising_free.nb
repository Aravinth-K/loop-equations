           RowBox[{"{", "#", "}"}], ",", "L2Variables"}], "]"}], "]"}], " ", "<=",
         " ", "2"}], " ", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"CoMat2", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{
