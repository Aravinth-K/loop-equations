            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{
            SubscriptBox["l", 
             RowBox[{"{", 
              RowBox[{"3", ",", "1"}], "}"}]], "=", 
            RowBox[{"A", "/.", 
