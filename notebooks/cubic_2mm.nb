Cell[TextData[{"The curve ", Cell[BoxData[FormBox[RowBox[{"P", "(", RowBox[{"z", ",", "\[Omega]"}], ")", "=", "0"}], TraditionalForm]], "InlineFormula"], " has degree four in ", "\[Omega]", " and degree five in z, with three independent correlators ", Cell[BoxData[FormBox[SubscriptBox["p", RowBox[{"{", RowBox[{"0"}], "}"}]], TraditionalForm]], "InlineFormula"], ", ", Cell[BoxData[FormBox[SubscriptBox["p", RowBox[{"{", RowBox[{"1"}], "}"}]], TraditionalForm]], "InlineFormula"], " and ", Cell[BoxData[FormBox[SubscriptBox["p", RowBox[{"{", RowBox[{"1", ",", "1"}], "}"}]], TraditionalForm]], "InlineFormula"], ". All potential coefficients remain symbolic."}], "Text",
 ExpressionUUID->"f076e855-e649-460f-8465-62af1114f8d3"]
}, Closed]],

Cell[CellGroupData[{
Cell["Asymptotics", "Section",
 ExpressionUUID->"0f5b66a6-481a-4a27-b86e-9a0e5d0c18b3"],

Cell[TextData[{"For generic couplings, expand the four sheets as ", Cell[BoxData[FormBox[RowBox[{"z", "\[Rule]", "\[Infinity]"}], TraditionalForm]], "InlineFormula"], ". The first sheet is the normalized resolvent; the others have one linear and two quadratic leading terms. Match powers in P for the quadratic sheets, then obtain the linear sheet from the sum of the four roots."}], "Text",
 ExpressionUUID->"dd74367a-9296-4188-a342-c70761231ef3"],

