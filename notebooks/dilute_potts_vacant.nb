         RowBox[{
          SubscriptBox["\[Omega]", 
           RowBox[{
            SubscriptBox["var", "7"], "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", 
             SubscriptBox["var", "7"], "]"}]}], "}"}]}], "]"}]}], "]"}], "\[LeftDoubleBracket]",
       "2", "\[RightDoubleBracket]"}], "]"}]}], ";", "\[IndentingNewLine]", 
