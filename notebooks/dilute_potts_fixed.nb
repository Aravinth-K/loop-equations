Cell[CellGroupData[{

Cell["Level 2 & 1 Constraints", "Section",ExpressionUUID->"4390d04a-1ca9-48df-a2f2-871e3bfef839"],

Cell["\<\
The elementary loop equations determine five auxiliary resolvents directly. A \
linear carried constraint determines the sixth. We then solve the remaining \
correlator constraints and take the common polynomial factor of the resulting \
resolvent equations.\
\>", "Text",ExpressionUUID->"cfba75a8-3207-4a2c-bb4c-7e124365c65b"],

Cell[BoxData[
 RowBox[{"Timing", "[", 
  RowBox[{
   RowBox[{"L2Eq", "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"Eq", ",", "4"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           SubscriptBox["Con3", "j"], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Length", "[", "list2", "]"}]}], "}"}]}], "]"}]}], "]"}],
        "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Sol", "=", 
    RowBox[{"First", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Eq", "\[LeftDoubleBracket]", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "8"}], "}"}], 
           "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
          RowBox[{
          "CoEqSol", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
          ")"}], "\[Equal]", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["\[Omega]", 
          RowBox[{"{", "3", "}"}]], ",", 
         SubscriptBox["\[Omega]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}]], ",", 
         SubscriptBox["\[Omega]", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]], ",", 
         SubscriptBox["\[Omega]", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]], ",", 
         SubscriptBox["\[Omega]", 
          RowBox[{"{", "1", "}"}]]}], "}"}]}], "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"L1Eq", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"reduce", ",", "pivot", ",", "auxiliary"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"reduce", "[", "e_", "]"}], ":=", 
        RowBox[{"Factor", "[", 
         RowBox[{"Numerator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            RowBox[{"e", "/.", "\[VeryThinSpace]", 
             RowBox[{
             "CoEqSol", "\[LeftDoubleBracket]", "1", 
              "\[RightDoubleBracket]"}]}], "/.", "\[VeryThinSpace]", 
            "L2Sol"}], "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pivot", "=", 
        RowBox[{"reduce", "[", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"SortBy", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{"L2Eq", ",", 
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"FreeQ", "[", 
                  RowBox[{"#1", ",", 
                   SubscriptBox["\[Omega]", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]]}], "]"}]}], "&"}]}], 
              "]"}], ",", "LeafCount"}], "]"}], ",", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"r", "=", 
                RowBox[{"reduce", "[", "#1", "]"}]}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Exponent", "[", 
                 RowBox[{"r", ",", 
                  SubscriptBox["\[Omega]", 
                   RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]]}], "]"}], "\[Equal]", 
                "1"}], "&&", 
               RowBox[{"FreeQ", "[", 
                RowBox[{
                 RowBox[{"Coefficient", "[", 
                  RowBox[{"r", ",", 
                   SubscriptBox["\[Omega]", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "2"}], "}"}]]}], "]"}], ",", 
                 RowBox[{"\[Omega]", "|", "z", "|", 
                  SubscriptBox["p", "_"]}]}], "]"}]}]}], "]"}], "&"}]}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"auxiliary", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"pivot", "\[Equal]", "0"}], ",", 
           SubscriptBox["\[Omega]", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}]]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Factor", "[", 
              RowBox[{"Numerator", "[", 
               RowBox[{"Together", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "/.", "\[VeryThinSpace]", 
                   RowBox[{
                   "CoEqSol", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}], "/.", "\[VeryThinSpace]", 
                  "L2Sol"}], "/.", "\[VeryThinSpace]", "auxiliary"}], "]"}], 
               "]"}], "]"}], "&"}], ")"}], "/@", "L2Eq"}], "]"}], ",", "0"}], 
        "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"FinCurve", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"residuals", "=", "L1Eq"}], ",", "protected", ",", "corEq", ",",
         "corVars", ",", "rules", ",", "polynomial"}], "}"}], ",", 
      RowBox[{
       RowBox[{"protected", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["p", "#1"], "&"}], ")"}], "/@", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", "0", "}"}], ",", 
           RowBox[{"{", "3", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "2", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0", ",", "2", ",", "3"}], "}"}]}], 
          "}"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"corEq", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"CoefficientList", "[", 
                   RowBox[{"#1", ",", "z"}], "]"}], "&"}], ")"}], "/@", 
                RowBox[{"Select", "[", 
                 RowBox[{"residuals", ",", 
                  RowBox[{
                   RowBox[{"FreeQ", "[", 
                    RowBox[{"#1", ",", "\[Omega]"}], "]"}], "&"}]}], "]"}]}], 
               "]"}], "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"Length", "[", "corEq", "]"}], ">", "0"}]}], ",", 
         RowBox[{
          RowBox[{"corVars", "=", 
           RowBox[{"Reverse", "[", 
            RowBox[{"SortBy", "[", 
             RowBox[{
              RowBox[{"Complement", "[", 
               RowBox[{
                RowBox[{"DeleteDuplicates", "[", 
                 RowBox[{"Cases", "[", 
                  RowBox[{"corEq", ",", 
                   SubscriptBox["p", "_List"], ",", "\[Infinity]"}], "]"}], 
                 "]"}], ",", "protected"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"Last", "[", "#1", "]"}], "]"}], "&"}], ",", 
                "Identity"}], "}"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"rules", "=", 
           RowBox[{"First", "[", 
            RowBox[{"Quiet", "[", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{"corEq", "\[Equal]", "0"}], ",", "corVars"}], "]"}], ",", 
              StyleBox[
               RowBox[{"Solve", "::", "svars"}], "MessageName"]}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"residuals", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Factor", "[", 
                  RowBox[{"Numerator", "[", 
                   RowBox[{"Together", "[", 
                    RowBox[{"#1", "/.", "\[VeryThinSpace]", "rules"}], "]"}], 
                   "]"}], "]"}], "&"}], ")"}], "/@", "residuals"}], "]"}], ",",
              "0"}], "]"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"polynomial", "=", 
        RowBox[{"PolynomialGCD", "@@", "residuals"}]}], ";", 
