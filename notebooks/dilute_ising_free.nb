Cell[TextData[{
 "The spectral curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"P", "(", "z", ",", "\[Omega]", ")", "=", "0"}], TraditionalForm]],
   "InlineFormula",ExpressionUUID->"dba3a3ca-c899-4b3d-8cff-d4f71be14cfa"],
 " has degree 10 in both variables and depends on five correlator moduli. \
Normalize its highest power of ",
 "\[Omega]",
 " to one. The cubic parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "0"], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "924dc0a1-eb6e-4e01-a910-cd02611452ff"],
 " and ",
