Cell[CellGroupData[{

Cell["Level 5 Constraints", "Section",ExpressionUUID->"a55ad253-5452-4691-9975-5c23d0bec814"],

Cell[TextData[{
 StyleBox["Perform the following :\n  1. Tabulates the relevant equations at \
this level.\n  2. Compute the matrix of coefficients for the level 5 \
resolvent functions.\n  3. Row - reduce the transpose of the coefficient \
matrix. \n  4. Reading off the column numbers of the first ' 1' entry in each \
row indicates the linearly independent set of equations.\n  5. Find the set \
of coefficients such that you can write the linearly independent equations in \
terms of the found basis.\n  6. Eliminate level 5 resolvent functions leaving \
only constraints on lower order functions.", "Text",
  FontWeight->"Plain"],
 StyleBox["\n     ", "Text"]
}], "Input",
 CellChangeTimes->{{3.9978451255017776`*^9, 
  3.997845134838871*^9}},ExpressionUUID->"bd8be28c-ed61-4b66-987e-\
6ec482bab161"],

