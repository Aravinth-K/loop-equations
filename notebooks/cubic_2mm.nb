Cell[BoxData[RowBox[{"(* Split a resolvent word into its exterior zeros and remaining word. *)", "\[IndentingNewLine]", "\[IndentingNewLine]", RowBox[{RowBox[{RowBox[{"sep", "[", "A_", "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"x", ",", "B"}], "}"}], ",", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "A", "]"}], "\[NotEqual]", "0"}], ",", RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Length", "[", "A", "]"}], "\[NotEqual]", RowBox[{"Length", "[", RowBox[{"Position", "[", RowBox[{"A", ",", "0"}], "]"}], "]"}]}], ",", RowBox[{RowBox[{"x", "=", RowBox[{RowBox[{"Position", "[", RowBox[{"A", ",", RowBox[{"_", "?", RowBox[{"(", RowBox[{RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", "1"}], "]"}], "-", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}], "+", RowBox[{"Position", "[", RowBox[{RowBox[{"Reverse", "[", "A", "]"}], ",", RowBox[{"_", "?", RowBox[{"(", RowBox[{RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", "1"}], "]"}], "-", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}]}]}], ";", "\[IndentingNewLine]", RowBox[{"B", "=", RowBox[{"{", RowBox[{RowBox[{"Table", "[", RowBox[{"0", ",", RowBox[{"{", RowBox[{"i", ",", "1", ",", RowBox[{RowBox[{"x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", RowBox[{"Table", "[", RowBox[{RowBox[{"A", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], ",", RowBox[{"{", RowBox[{"j", ",", RowBox[{RowBox[{RowBox[{"Position", "[", RowBox[{"A", ",", RowBox[{"_", "?", RowBox[{"(", RowBox[{RowBox[{"#1", "\[NotEqual]", "0"}], "&"}], ")"}]}], ",", "1", ",", "1"}], "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", RowBox[{RowBox[{"Length", "[", "A", "]"}], "-", RowBox[{RowBox[{RowBox[{"Position", "[", RowBox[{RowBox[{"Reverse", "[", "A", "]"}], ",", RowBox[{"_", "?", RowBox[{"(", RowBox[{RowBox[{"#1", "\[NotEqual]", "0"}