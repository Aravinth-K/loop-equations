Cell[CellGroupData[{

Cell["Level 6 Constraints", "Section",ExpressionUUID->"c27e8852-8a4d-4ba7-abde-846a1d80fec4"],

Cell[TextData[{
 StyleBox["Perform the following :\n  1. Tabulates the relevant equations at \
this level .\n  2. Compute the matrix of coefficients for the level 6 \
resolvent functions .\n  3. Row - reduce the transpose of the coefficient \
matrix . \n  4. Reading off the column numbers of the first ' 1' entry in \
each row indicates the linearly independent set of equations .\n  5. Find the \
set of coefficients such that you can write the linearly independent \
equations in terms of the found basis .\n  6. Eliminate level 6 resolvent \
functions leaving only constraints on lower order functions .", "Text",
  FontWeight->"Plain"],
 StyleBox["\n     ", "Text"]
}], "Input",
 CellLabel->
  "In[202]:=",ExpressionUUID->"e2d34d8b-de6c-43c8-a065-6bfc6e3b36f3"],

