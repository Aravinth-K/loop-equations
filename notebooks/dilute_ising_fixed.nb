   "\[IndentingNewLine]", 
   RowBox[{"list1", " ", "=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Position", "[", 
        RowBox[{
         RowBox[{"tempMat", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", " ", "!=", " ", "0"}], " ", "&"}], ")"}]}], ",", "1",
          ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "tempMat", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "list1", "]"}], " ", "=!=", " ", 
      RowBox[{"Length", "[", "L1Variables", "]"}]}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"L1Sol", " ", "=", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"L1Linear", "[", 
         RowBox[{"[", "list1", "]"}], "]"}], " ", "\[Equal]", " ", "0"}], 
       "]"}], ",", "L1Variables"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "L1Sol", "]"}], " ", "=!=", " ", "1"}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"EliminationConstraints", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"primitive", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"L1Eq", " ", "/.", " ", 
          RowBox[{"L1Sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L0", " ", "=", " ", 
    RowBox[{"PolynomialGCD", " ", "@@", " ", "EliminationConstraints"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"CurveConstraints", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
