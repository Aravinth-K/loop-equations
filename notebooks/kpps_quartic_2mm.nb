Cell[CellGroupData[{

Cell["Level 2 & 1 Constraints", "Subsection",ExpressionUUID->"5f62240f-ca24-4a71-abc8-69bd8d46fc0c"],

Cell["\<\
The signed sector removes the level 1 resolvent. Solve the remaining linear \
relation for the level 2 resolvent, then take the common polynomial factor of \
every residual equation.\
\>", "Text",ExpressionUUID->"65c52785-9843-4c6d-96c6-bdeb4af3d119"],

Cell[BoxData[
 RowBox[{"Timing", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"L2Eq", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"Eq", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"resolventLevel", "[", "#", "]"}], " ", "<=", " ", "2"}],
             " ", "&"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           SubscriptBox["Con3", "j"], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "nCon3"}], "}"}]}], "]"}]}], "]"}], 
       "]"}], ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Linear", " ", "=", " ", 
    RowBox[{"First", "[", 
     RowBox[{"Select", "[", 
      RowBox[{"L2Eq", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", 
           SubscriptBox["\[Omega]", 
            RowBox[{"{", "1", ",", "1", "}"}]]}], "]"}], " ", "\[Equal]", " ",
          "1"}], " ", "&"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Sol", " ", "=", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"L2Linear", " ", "\[Equal]", " ", "0"}], ",", 
      SubscriptBox["\[Omega]", 
       RowBox[{"{", "1", ",", "1", "}"}]]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "L2Sol", "]"}], " ", "=!=", " ", "1"}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"EliminationConstraints", " ", "=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"primitive", " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"L2Eq", " ", "/.", " ", 
          RowBox[{"L2Sol", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "]"}], ",", "0"}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"L0", " ", "=", " ", 
    RowBox[{"PolynomialGCD", " ", "@@", " ", "EliminationConstraints"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"CurveConstraints", " ", "=", " ", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"First", " ", "/@", " ", 
       RowBox[{"Rest", "[", 
        RowBox[{"FactorList", "[", "L0", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "\[Omega]"}], "]"}], " ", ">=", " ", "2"}], " ", "&&",
         " ", 
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{"#", ",", "z"}], "]"}], " ", ">=", " ", "1"}]}], " ", 
       "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "CurveConstraints", "]"}], " ", "=!=", " ", 
      "1"}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"FinCurve", " ", "=", " ", 
    RowBox[{"Expand", "[", 
     RowBox[{"First", "[", "CurveConstraints", "]"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"ReductionChecks", " ", "=", " ", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"PolynomialRemainder", "[", 
            RowBox[{"#", ",", "FinCurve", ",", "\[Omega]"}], "]"}], " ", "===",
            " ", "0"}], " ", "&"}], " ", "/@", " ", 
         "EliminationConstraints"}], ")"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"PolynomialGCD", "[", 
        RowBox[{"FinCurve", ",", 
         RowBox[{"Denominator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            SubscriptBox["\[Omega]", 
             RowBox[{"{", "1", ",", "1", "}"}]], " ", "/.", " ", 
            RowBox[{"L2Sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], " ", "===",
        " ", "1"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"FinCurve", ",", 
         SubscriptBox["\[Omega]", "_List"], ",", "\[Infinity]"}], "]"}], " ", 
       "===", " ", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"And", " ", "@@", " ", "ReductionChecks"}]}], ",", 
