    "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "list1", "]"}], " ", "=!=", " ", 
      RowBox[{"Length", "[", "L2Variables", "]"}]}], ",", 
     RowBox[{"Abort", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
   RowBox[{"L2Sol", " ", "=", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Thread", "[", 
